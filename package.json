{
  "name": "dsh-scientist",
  "version": "0.2.0",
  "description": "科学家模式 — 面向数理/物理工程材料/AI 计算科学的 DSH agent preset：领域调研、文献检索（lit_* 4 个原生工具）、专业推导（sympy + pint + uncertainties + LaTeX）、出图与统计规范、版本化工件与溯源。",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "agent-preset",
    "science",
    "research",
    "literature",
    "derivation",
    "reproducibility"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blake-John/dsh-scientist.git"
  },
  "homepage": "https://github.com/Blake-John/dsh-scientist#readme",
  "bugs": {
    "url": "https://github.com/Blake-John/dsh-scientist/issues"
  },
  "exports": {
    "./skills-provider.mjs": "./skills-provider.mjs",
    "./lit-tools.mjs": "./lit-tools.mjs",
    "./pdf-tools.mjs": "./pdf-tools.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "LICENSE",
    "agent.cordis.yml",
    "cordis.patch.yml",
    "lit-core.mjs",
    "lit-tools.mjs",
    "pdf-tools.mjs",
    "skills",
    "skills-provider.mjs",
    "scripts",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:patch": "node scripts/build-patch.mjs",
    "lit": "node scripts/lit.mjs",
    "check": "node scripts/build-patch.mjs --check && node scripts/check-patch.mjs && node scripts/test-skills-provider.mjs && node scripts/test-lit-core.mjs && node scripts/test-lit-tools.mjs && node scripts/test-pdf-tools.mjs && node scripts/test-lit-lib.mjs && python3 scripts/validate.py",
    "check:live": "node scripts/test-lit-tools.mjs --live",
    "prepublishOnly": "npm run check"
  }
}
